diff --git a/CMakeLists.txt b/CMakeLists.txt
index 90b368d..672393c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -207,7 +207,7 @@ if(EMSCRIPTEN)
   set(SDL_SHARED_AVAILABLE OFF)
 endif()
 
-if(VITA OR PSP OR PS2 OR N3DS OR RISCOS OR NGAGE)
+if(VITA OR PSP OR PS2 OR N3DS OR RISCOS OR NGAGE OR PS5)
   set(SDL_SHARED_AVAILABLE OFF)
 endif()
 
@@ -1372,7 +1372,7 @@ if(SDL_CAMERA)
   #endif()
 endif()
 
-if(UNIX OR APPLE)
+if((UNIX OR APPLE) AND NOT PS5)
   # Relevant for Unix/Darwin only
   set(DYNAPI_NEEDS_DLOPEN 1)
   CheckDLOPEN()
@@ -1771,6 +1771,51 @@ elseif(EMSCRIPTEN)
   CheckPTHREAD()
   CheckLibUnwind()
 
+elseif(PS5)
+  # PlayStation 5 (ps5-payload-sdk): a FreeBSD-like libc, scePad, sceAudioOut, and Vulkan through RADV
+  # linked into the title, presenting with VK_KHR_display on VideoOut (Outsider PS5).
+  if(SDL_AUDIO)
+    set(SDL_AUDIO_DRIVER_PS5 1)
+    sdl_glob_sources("${SDL3_SOURCE_DIR}/src/audio/ps5/*.c" "${SDL3_SOURCE_DIR}/src/audio/ps5/*.h")
+    set(HAVE_SDL_AUDIO TRUE)
+  endif()
+  if(SDL_JOYSTICK)
+    set(SDL_JOYSTICK_PS5 1)
+    sdl_glob_sources("${SDL3_SOURCE_DIR}/src/joystick/ps5/*.c" "${SDL3_SOURCE_DIR}/src/joystick/ps5/*.h")
+    set(HAVE_SDL_JOYSTICK TRUE)
+  endif()
+  if(SDL_VIDEO)
+    set(SDL_VIDEO_DRIVER_PS5 1)
+    sdl_glob_sources("${SDL3_SOURCE_DIR}/src/video/ps5/*.c" "${SDL3_SOURCE_DIR}/src/video/ps5/*.h")
+    set(HAVE_SDL_VIDEO TRUE)
+    CheckVulkan()
+  endif()
+
+  CheckPTHREAD()
+  set(HAVE_CLOCK_GETTIME 1)
+
+  # SDL_PLATFORM_UNIX's common code (SDL_Quit() calls its GTK clean-up; there is no GTK to load)
+  sdl_glob_sources("${SDL3_SOURCE_DIR}/src/core/unix/*.c" "${SDL3_SOURCE_DIR}/src/core/unix/*.h")
+
+  sdl_glob_sources("${SDL3_SOURCE_DIR}/src/locale/unix/*.c")
+  set(HAVE_SDL_LOCALE TRUE)
+
+  set(SDL_FILESYSTEM_UNIX 1)
+  sdl_glob_sources("${SDL3_SOURCE_DIR}/src/filesystem/unix/*.c")
+  set(HAVE_SDL_FILESYSTEM TRUE)
+
+  set(SDL_FSOPS_POSIX 1)
+  sdl_sources("${SDL3_SOURCE_DIR}/src/filesystem/posix/SDL_sysfsops.c")
+  set(HAVE_SDL_FSOPS TRUE)
+
+  set(SDL_TIME_UNIX 1)
+  sdl_glob_sources("${SDL3_SOURCE_DIR}/src/time/unix/*.c")
+  set(HAVE_SDL_TIME TRUE)
+
+  set(SDL_TIMER_UNIX 1)
+  sdl_glob_sources("${SDL3_SOURCE_DIR}/src/timer/unix/*.c")
+  set(HAVE_SDL_TIMERS TRUE)
+
 elseif(UNIX AND NOT APPLE AND NOT RISCOS AND NOT HAIKU)
 
   set(SDL_DISABLE_DLOPEN_NOTES TRUE)
@@ -3471,7 +3516,7 @@ if (SDL_DIALOG)
     set(HAVE_SDL_DIALOG TRUE)
   endif()
 endif()
-if(UNIX AND NOT APPLE AND NOT RISCOS AND NOT HAIKU)
+if(UNIX AND NOT APPLE AND NOT RISCOS AND NOT HAIKU AND NOT PS5)
   sdl_sources(${SDL3_SOURCE_DIR}/src/dialog/unix/SDL_zenitymessagebox.h)
   sdl_sources(${SDL3_SOURCE_DIR}/src/dialog/unix/SDL_zenitymessagebox.c)
 endif()
